      "@type": "@vocab"
    },
    "ontology": {
      "@id": "bopv:ontology"
    },
    "_comment_excluded": "source_path, counts, commit, generated, canonical_base, content_digest, endpoints and next_ids are export bookkeeping, not content. tools/export_rdf.py drops them and fails if any OTHER key reaches it unmapped, so this context cannot silently fall behind the schema again.",
    "bops": {
      "@id": "bopv:bop",
      "@container": "@set"
    }
  }
