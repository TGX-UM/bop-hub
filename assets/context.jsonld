{
  "@context": {
    "@version": 1.1,
    "_comment_vocab": "@vocab makes a graded value an IRI: essentiality `strong` becomes bopv:strong, which is a SKOS concept in the published vocabulary rather than a bare string. It also means an unmapped KEY would quietly expand to bopv:<key> instead of being dropped, so tools/export_rdf.py checks each key against this context explicitly and will not rely on that.",
    "@vocab": "https://w3id.org/bop-hub/vocab#",
    "_comment_namespaces": "aopo, ncit, edam, obo and ncbitaxon are the namespaces AOP-Wiki RDF itself uses, so a predicate reused from there joins without translation. bopv is BOP-Hub's own vocabulary, for the concepts the AOP framework has no term for. nci is kept as an alias of ncit because earlier versions of this context used it.",
    "aopo": "http://aopkb.org/aop_ontology#",
    "ncit": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#",
    "nci": "http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#",
    "edam": "http://edamontology.org/",
    "obo": "http://purl.obolibrary.org/obo/",
    "ncbitaxon": "http://purl.bioontology.org/ontology/NCBITAXON/",
    "dcterms": "http://purl.org/dc/terms/",
    "dc": "http://purl.org/dc/elements/1.1/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "pav": "http://purl.org/pav/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "bop": "https://w3id.org/bop-hub/",
    "bopv": "https://w3id.org/bop-hub/vocab#",
    "GO": "http://purl.obolibrary.org/obo/GO_",
    "CHEBI": "http://purl.obolibrary.org/obo/CHEBI_",
    "CL": "http://purl.obolibrary.org/obo/CL_",
    "UBERON": "http://purl.obolibrary.org/obo/UBERON_",
    "PATO": "http://purl.obolibrary.org/obo/PATO_",
    "MONDO": "http://purl.obolibrary.org/obo/MONDO_",
    "DOID": "http://purl.obolibrary.org/obo/DOID_",
    "HP": "http://purl.obolibrary.org/obo/HP_",
    "EFO": "http://purl.obolibrary.org/obo/EFO_",
    "NCBITaxon": "http://purl.obolibrary.org/obo/NCBITaxon_",
    "HsapDv": "http://purl.obolibrary.org/obo/HsapDv_",
    "FOODON": "http://purl.obolibrary.org/obo/FOODON_",
    "MESH": "http://id.nlm.nih.gov/mesh/",
    "UniProt": "http://purl.uniprot.org/uniprot/",
    "Reactome": "https://reactome.org/content/detail/",
    "WP": "https://identifiers.org/wikipathways:",
    "aop": "https://identifiers.org/aop/",
    "aop.events": "https://identifiers.org/aop.events/",
    "aop.relationships": "https://identifiers.org/aop.relationships/",
    "iri": "@id",
    "page_iri": {
      "@id": "bopv:canonicalIri",
      "@type": "@id"
    },
    "url": {
      "@id": "foaf:page",
      "@type": "@id"
    },
    "identifier": {
      "@id": "dcterms:identifier"
    },
    "title": {
      "@id": "dcterms:title"
    },
    "short_title": {
      "@id": "dcterms:alternative"
    },
    "description": {
      "@id": "dcterms:description"
    },
    "body_markdown": {
      "@id": "bopv:body"
    },
    "label": {
      "@id": "rdfs:label"
    },
    "definition": {
      "@id": "skos:definition"
    },
    "synonyms": {
      "@id": "skos:altLabel",
      "@container": "@set"
    },
    "comment": {
      "@id": "rdfs:comment"
    },
    "note": {
      "@id": "rdfs:comment"
    },
    "created": {
      "@id": "dcterms:created",
