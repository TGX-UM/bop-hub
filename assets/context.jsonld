    },
    "modified": {
      "@id": "dcterms:modified",
      "@type": "xsd:date"
    },
    "license": {
      "@id": "dcterms:license",
      "@type": "@id"
    },
    "status": {
      "@id": "bopv:status",
      "@type": "@vocab"
    },
    "replaced_by": {
      "@id": "dcterms:isReplacedBy",
      "@type": "@id"
    },
    "references": {
      "@id": "dcterms:references",
      "@container": "@set"
    },
    "citation": {
      "@id": "dcterms:bibliographicCitation"
    },
    "doi": {
      "@id": "bopv:doi"
    },
    "pmid": {
      "@id": "bopv:pmid"
    },
    "pmcid": {
      "@id": "bopv:pmcid"
    },
    "curators": {
      "@id": "pav:curatedBy",
      "@container": "@set"
    },
    "orcid": "@id",
