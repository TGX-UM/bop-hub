      "@id": "skos:exactMatch",
      "@type": "@id"
    },
    "aopwiki_ker": {
      "@id": "skos:exactMatch",
      "@type": "@id"
    },
    "aopwiki_mirror_ke": {
      "@id": "skos:related",
      "@type": "@id"
    },
    "wikipathways": {
      "@id": "skos:related",
      "@type": "@id",
      "@container": "@set"
    },
    "external_ids": {
      "@id": "skos:related",
      "@type": "@id",
      "@container": "@set"
    },
    "related_aops": {
      "@id": "bopv:relatedAop",
      "@container": "@set"
    },
