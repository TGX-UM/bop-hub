{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/bop-hub/schema/annotation",
  "title": "Ontology term",
  "type": "object",
  "required": [
    "identifier",
    "label",
    "slot",
    "ontology",
    "iri"
  ],
  "additionalProperties": false,
  "properties": {
    "layout": {
      "type": "string"
    },
    "redirect_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "identifier": {
      "$ref": "_defs#/$defs/curie",
      "description": "The page's own identifier. NOT named `id`: Jekyll's Document#id shadows a front-matter `id` and returns the document path instead, so every Liquid lookup silently fails. See CONTRIBUTING.md."
    },
    "label": {
      "type": "string"
    },
    "slot": {
      "type": "array",
      "minItems": 1,
      "description": "Which front-matter slots use this term. Must be members of site.annotation_slots.",
      "items": {
        "type": "string"
      }
    },
    "ontology": {
      "type": "string"
    },
    "iri": {
      "type": "string",
      "pattern": "^https?://"
    },
    "definition": {
      "type": "string"
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
