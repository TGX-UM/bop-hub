{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/bop-hub/schema/event",
  "title": "Event (initiating event, key event or beneficial outcome)",
  "type": "object",
  "required": ["id", "title", "description", "biological_level", "status", "references", "curators", "created", "modified"],
  "additionalProperties": false,
  "properties": {
    "layout": {"type": "string"},
    "redirect_from": {"type": "array", "items": {"type": "string"}},

    "id": {"type": "string", "pattern": "^BOPE:[0-9]{4}$"},
    "title": {"type": "string", "minLength": 5},
    "description": {"type": "string", "minLength": 30},
    "biological_level": {"type": "string", "x-vocab": "biological_level"},

    "process": {"$ref": "_defs#/$defs/curie"},
    "object": {"$ref": "_defs#/$defs/curie"},
    "action": {"$ref": "_defs#/$defs/curie"},

    "aopwiki_ke": {"type": "string", "pattern": "^aop\\.events:[0-9]+$"},
    "wikipathways": {"type": "array", "items": {"type": "string", "pattern": "^WP[0-9]+$"}},
    "external_ids": {"$ref": "_defs#/$defs/curieList"},

    "taxa": {"$ref": "_defs#/$defs/curieList"},
    "sex": {"$ref": "_defs#/$defs/curieList"},
    "life_stage": {"$ref": "_defs#/$defs/curieList"},

    "measurement_methods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "reference": {"type": "string"}
        }
      }
    },

    "status": {"type": "string", "x-vocab": "status"},
    "references": {"$ref": "_defs#/$defs/referenceList"},
    "curators": {"type": "array", "minItems": 1, "items": {"$ref": "_defs#/$defs/curator"}},
    "created": {"type": "string", "format": "date"},
    "modified": {"type": "string", "format": "date"},
    "license": {"type": "string"},
    "replaced_by": {"type": "string"}
  }
}
